{
  "name": "devimage",
  "version": "0.1.0",
  "private": true,
  "description": "国内开发者占位资源 CDN — 图片、头像、Mock 数据",
  "scripts": {
    "setup": "pnpm install",
    "dev": "pnpm -r --parallel --filter @devimage/api --filter @devimage/docs dev",
    "dev:api": "pnpm --filter @devimage/api dev",
    "dev:docs": "pnpm --filter @devimage/docs dev",
    "build": "pnpm -r --filter @devimage/api --filter @devimage/docs build",
    "build:api": "pnpm --filter @devimage/api build",
    "build:docs": "pnpm --filter @devimage/docs build",
    "start:prod": "pnpm --filter @devimage/api start:prod",
    "test": "pnpm --filter @devimage/api test",
    "lint": "pnpm --filter @devimage/api lint",
    "photo:manifest": "python3 scripts/photo-library/build_manifest.py",
    "photo:upload": "python3 scripts/photo-library/upload_cos.py",
    "avatar:split": "pnpm --filter @devimage/avatar-assets split",
    "avatar:matte": "pnpm --filter @devimage/avatar-assets matte",
    "avatar:validate": "pnpm --filter @devimage/avatar-assets validate",
    "deploy": "bash deploy/scripts/deploy.sh",
    "deploy:pull": "bash deploy/scripts/pull.sh",
    "deploy:build": "bash deploy/scripts/build.sh",
    "deploy:start": "bash deploy/scripts/start.sh",
    "deploy:stop": "bash deploy/scripts/stop.sh",
    "deploy:restart": "bash deploy/scripts/restart.sh",
    "deploy:status": "bash deploy/scripts/status.sh",
    "deploy:logs": "bash deploy/scripts/logs.sh",
    "deploy:health": "bash deploy/scripts/health.sh",
    "deploy:remote": "bash deploy/scripts/remote.sh"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0"
}
